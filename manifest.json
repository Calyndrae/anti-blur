{
  "manifest_version": 3,
  "name": "Anti Blur — Keep Pages Active",
  "short_name": "Anti Blur",
  "version": "1.0.0",
  "description": "Stops sites from pausing, dimming or tracking you when you switch tabs or click away. No data collected. No account needed.",
  "author": "Calyndrae",
  "homepage_url": "https://calyndrae.com/projects/anti-blur",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Anti Blur",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
